          },
          "editorMode": "code",
          "expr": "sum by (le) (increase(gmod_player_session_duration_seconds_bucket{job=\"$job\", instance=\"$instance\"}[$__interval]))",
          "legendFormat": "{{le}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "description": "Session length per 10 minutes in each histogram bucket. Average length of the sessions that ended during the selected time range, and their number.",
      "interval": "10m",
