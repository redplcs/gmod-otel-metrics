{
  "uid": "gmod-players",
  "title": "Garry's Mod / players",
  "description": "Players online, joins and disconnects, sessions, activity and connection quality.",
  "tags": [
    "gmod-otel-metrics"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Back to Garry's Mod / fleet overview",
      "type": "link",
      "url": "/d/gmod-fleet",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": "",
      "tags": [],
      "asDropdown": false
    },
    {
      "title": "All Garry's Mod / dashboards",
      "type": "dashboards",
      "tags": [
        "gmod-otel-metrics"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Map starts",
        "expr": "max(gmod_map_start_time_seconds{job=\"$job\", instance=\"$instance\"}) * 1000",
        "step": "60s",
        "titleFormat": "Map started",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": true
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "regex": "(?!grafanacloud-usage|grafanacloud-ml-metrics).+"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gmod_collector_enabled, job)",
        "definition": "label_values(gmod_collector_enabled, job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "instance",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gmod_collector_enabled{job=\"$job\"}, instance)",
        "definition": "label_values(gmod_collector_enabled{job=\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "export_interval",
        "label": "Export interval",
        "type": "custom",
        "description": "The servers' otel_metrics_interval. Used as the minimum query step.",
        "query": "15s,30s,60s",
        "current": {
          "text": "15s",
          "value": "15s",
          "selected": true
        },
        "options": [
          {
            "text": "15s",
            "value": "15s",
            "selected": true
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": false
          },
          {
            "text": "60s",
            "value": "60s",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Online",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Players online",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(gmod_player_count{job=\"$job\", instance=\"$instance\", player_kind=\"human\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Human players on the server. Bots are counted separately on the Players dashboard.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Players",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 20,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (player_kind) (gmod_player_count{job=\"$job\", instance=\"$instance\"})",
          "legendFormat": "{{player_kind}}",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(gmod_player_limit{job=\"$job\", instance=\"$instance\"})",
          "legendFormat": "slots",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "description": "Humans and bots on the server, against the player slots (maxplayers).",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "slots"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Joins and disconnects",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Joins and disconnects per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum (increase(gmod_player_connections_total{job=\"$job\", instance=\"$instance\"}[$__interval] offset -$__interval))",
          "legendFormat": "joined",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (disconnect_reason) (increase(gmod_player_disconnects_total{job=\"$job\", instance=\"$instance\"}[$__interval] offset -$__interval))",
          "legendFormat": "left: {{disconnect_reason}}",
          "range": true,
          "instant": false,
          "refId": "B"
        }
      ],
      "description": "Joins per hour above the axis, disconnects by reason below it. The current hour fills in as it goes. Over the selected time range.\n\n- **client**: left on their own.\n- **timeout**: the connection dropped.\n- **kicked**, **banned**: removed by an admin or an addon.\n- **aborted**: left before they were fully in the game, often while downloading content.\n- **shutdown**: the server stopped or changed map.",
      "interval": "1h",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "barAlignment": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "joined"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "left: .*"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Disconnect reasons",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (disconnect_reason) (increase(gmod_player_disconnects_total{job=\"$job\", instance=\"$instance\"}[$__range]))",
          "legendFormat": "{{disconnect_reason}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Over the selected time range.\n\n- **client**: left on their own.\n- **timeout**: the connection dropped.\n- **kicked**, **banned**: removed by an admin or an addon.\n- **aborted**: left before they were fully in the game, often while downloading content.\n- **shutdown**: the server stopped or changed map.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "No disconnects"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 300
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Joining and sessions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Time to join",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gmod_player_join_duration_seconds_sum{job=\"$job\", instance=\"$instance\"}[$__range])) / sum(increase(gmod_player_join_duration_seconds_count{job=\"$job\", instance=\"$instance\"}[$__range])) > 0",
          "legendFormat": "average",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gmod_player_join_duration_seconds_count{job=\"$job\", instance=\"$instance\"}[$__range]))",
          "legendFormat": "joins",
          "range": false,
          "instant": true,
          "refId": "B"
        }
      ],
      "description": "Average time from connecting to being fully in the game, content download included, and the number of joins it is based on. Long joins usually mean large downloads; check the Workshop collection and FastDL.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "–"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "joins"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 9,
      "type": "heatmap",
      "title": "Time to join distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (le) (increase(gmod_player_join_duration_seconds_bucket{job=\"$job\", instance=\"$instance\"}[$__interval]))",
          "legendFormat": "{{le}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "description": "Time to join per 10 minutes in each histogram bucket. Average time from connecting to being fully in the game, content download included, and the number of joins it is based on. Long joins usually mean large downloads; check the Workshop collection and FastDL.",
      "interval": "10m",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5,
          "fill": "dark-orange",
          "steps": 64,
          "reverse": false
        },
        "cellGap": 1,
        "filterValues": {
          "le": 1e-09
        },
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "yHistogram": false,
          "showColorScale": false
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Session length",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gmod_player_session_duration_seconds_sum{job=\"$job\", instance=\"$instance\"}[$__range])) / sum(increase(gmod_player_session_duration_seconds_count{job=\"$job\", instance=\"$instance\"}[$__range])) > 0",
          "legendFormat": "average",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(gmod_player_session_duration_seconds_count{job=\"$job\", instance=\"$instance\"}[$__range]))",
          "legendFormat": "sessions",
          "range": false,
          "instant": true,
          "refId": "B"
        }
      ],
      "description": "Average length of the sessions that ended during the selected time range, and their number.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
