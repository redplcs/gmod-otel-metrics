{
  "uid": "gmod-fleet",
  "title": "Garry's Mod / fleet overview",
  "description": "All Garry's Mod servers that report OTel Metrics, at a glance.",
  "tags": [
    "gmod-otel-metrics"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "All Garry's Mod / dashboards",
      "type": "dashboards",
      "tags": [
        "gmod-otel-metrics"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "regex": "(?!grafanacloud-usage|grafanacloud-ml-metrics).+"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gmod_collector_enabled, job)",
        "definition": "label_values(gmod_collector_enabled, job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "instance",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gmod_collector_enabled{job=\"$job\"}, instance)",
        "definition": "label_values(gmod_collector_enabled{job=\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "regex": "",
        "allValue": ".+"
      },
      {
        "name": "export_interval",
        "label": "Export interval",
        "type": "custom",
        "description": "The servers' otel_metrics_interval. Used as the minimum query step.",
        "query": "15s,30s,60s",
        "current": {
          "text": "15s",
          "value": "15s",
          "selected": true
        },
        "options": [
          {
            "text": "15s",
            "value": "15s",
            "selected": true
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": false
          },
          {
            "text": "60s",
            "value": "60s",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servers reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(group by (instance) (gmod_collector_enabled{job=\"$job\", instance=~\"$instance\"}))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "Servers that sent metrics in the last 5 minutes.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last metrics",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(time() - max(timestamp(gmod_collector_enabled{job=\"$job\", instance=~\"$instance\"}))) or (time() - max(max_over_time(timestamp(gmod_collector_enabled{job=\"$job\", instance=~\"$instance\"})[24h:1m])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "How long ago the last metrics arrived, looking back up to 24 hours. More than a minute or two means the server or the export is down.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "No data in 24 h"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Addon version",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count by (telemetry_sdk_version) (topk by (instance) (1, timestamp(target_info{job=\"$job\", instance=~\"$instance\", telemetry_sdk_name=\"otel_metrics\"})))",
          "legendFormat": "{{telemetry_sdk_version}}",
          "range": false,
          "instant": true,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "Addon version, from the target_info metric. After updating the addon, restart the server to load it.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Players online",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(max by (instance) (gmod_player_count{job=\"$job\", instance=~\"$instance\", player_kind=\"human\"}))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "Human players on all selected servers.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Lua errors / min",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(gmod_lua_errors_total{job=\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "On all selected servers. Errors per minute, averaged over a minute: a single error shows as a short bump that goes back to zero a minute later. Lua errors on the server and errors that clients report to it. The text of each error is in the server console. Errors raised with Error or ErrorNoHalt are not counted, and GMod limits how many client errors reach the server.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Servers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "Servers",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (instance, map, gamemode) (topk by (instance) (1, timestamp(gmod_server_info{job=\"$job\", instance=~\"$instance\"})))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (gmod_player_count{job=\"$job\", instance=~\"$instance\", player_kind=\"human\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "B",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (gmod_player_limit{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "C",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate(gmod_server_ticks_total{job=\"$job\", instance=~\"$instance\"}[$__rate_interval])) * on (instance) max by (instance) (gmod_server_tick_interval_seconds{job=\"$job\", instance=~\"$instance\"}) / on (instance) sum by (instance) (rate(gmod_server_frame_duration_seconds_sum{job=\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "D",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (instance, le) (rate(gmod_physics_step_duration_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[$__rate_interval]))) / on (instance) max by (instance) (gmod_server_tick_interval_seconds{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "E",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate(gmod_lua_errors_total{job=\"$job\", instance=~\"$instance\"}[$__rate_interval])) * 60 or (max by (instance) (gmod_collector_enabled{job=\"$job\", instance=~\"$instance\"}) * 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "F",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (instance) (gmod_edict_count{job=\"$job\", instance=~\"$instance\"}) / on (instance) max by (instance) (gmod_edict_limit{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "G",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "time() - max by (instance) (gmod_map_start_time_seconds{job=\"$job\", instance=~\"$instance\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "H",
          "format": "table",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (instance, telemetry_sdk_version) (topk by (instance) (1, timestamp(target_info{job=\"$job\", instance=~\"$instance\", telemetry_sdk_name=\"otel_metrics\"})))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "I",
          "format": "table",
          "interval": "$export_interval"
        }
      ],
      "description": "Every selected server at a glance, slowest first. Click a server to open its overview.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false,
            "minWidth": 90
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Server"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open the server overview",
                    "targetBlank": false,
                    "url": "/d/gmod-otel-metrics?${__url_time_range}&${datasource:queryparam}&${job:queryparam}&var-instance=${__value.raw}&${export_interval:queryparam}"
                  }
                ]
              },
              {
                "id": "custom.minWidth",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Players"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Slots"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Simulation speed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.9
                    },
                    {
                      "color": "green",
                      "value": 0.98
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Physics per tick"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lua errors / min"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.1
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Edicts in use"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.75
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Map uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "Value #I": true
            },
            "indexByName": {
              "instance": 0,
              "map": 1,
              "gamemode": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8,
              "Value #H": 9,
              "telemetry_sdk_version": 10
            },
            "renameByName": {
              "instance": "Server",
              "map": "Map",
              "gamemode": "Gamemode",
              "telemetry_sdk_version": "Addon",
              "Value #B": "Players",
              "Value #C": "Slots",
              "Value #D": "Simulation speed",
              "Value #E": "Physics per tick",
              "Value #F": "Lua errors / min",
              "Value #G": "Edicts in use",
              "Value #H": "Map uptime"
            }
          }
        }
      ],
      "options": {
