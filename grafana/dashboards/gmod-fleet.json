    {
      "id": 9,
      "type": "timeseries",
      "title": "Simulation speed, slowest 10",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "bottomk(10, sum by (instance) (rate(gmod_server_ticks_total{job=\"$job\", instance=~\"$instance\"}[$__rate_interval])) * on (instance) max by (instance) (gmod_server_tick_interval_seconds{job=\"$job\", instance=~\"$instance\"}) / on (instance) sum by (instance) (rate(gmod_server_frame_duration_seconds_sum{job=\"$job\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "Share of the configured tick rate that the server actually simulated.\n\n- **100%**: the server keeps up.\n- **Below 100%**: the game runs in slow motion for everyone: movement, physics and timers slow down.\n\nUsually caused by physics (many unfrozen props touching each other) or by a heavy addon. Compare with *Physics per tick*: above 100% there, physics is the cause.\n\nSimulated time is divided by the real time the server ran, so the minutes after a start and before a gap in the data don't read low.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
