          "expr": "topk(10, histogram_quantile(0.5, sum by (instance, le) (rate(gmod_physics_step_duration_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[$__rate_interval]))) / on (instance) max by (instance) (gmod_server_tick_interval_seconds{job=\"$job\", instance=~\"$instance\"}))",
