{
  "uid": "gmod-lua",
  "title": "Garry's Mod / Lua",
  "description": "Lua errors by addon and Lua memory of one server.",
  "tags": [
    "gmod-otel-metrics"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Back to Garry's Mod / fleet overview",
      "type": "link",
      "url": "/d/gmod-fleet",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "dashboard",
      "tooltip": "",
      "tags": [],
      "asDropdown": false
    },
    {
      "title": "All Garry's Mod / dashboards",
      "type": "dashboards",
      "tags": [
        "gmod-otel-metrics"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Map starts",
        "expr": "max(gmod_map_start_time_seconds{job=\"$job\", instance=\"$instance\"}) * 1000",
        "step": "60s",
        "titleFormat": "Map started",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": true
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "hide": 0,
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "regex": "(?!grafanacloud-usage|grafanacloud-ml-metrics).+"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gmod_collector_enabled, job)",
        "definition": "label_values(gmod_collector_enabled, job)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "instance",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gmod_collector_enabled{job=\"$job\"}, instance)",
        "definition": "label_values(gmod_collector_enabled{job=\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0,
        "regex": ""
      },
      {
        "name": "export_interval",
        "label": "Export interval",
        "type": "custom",
        "description": "The servers' otel_metrics_interval. Used as the minimum query step.",
        "query": "15s,30s,60s",
        "current": {
          "text": "15s",
          "value": "15s",
          "selected": true
        },
        "options": [
          {
            "text": "15s",
            "value": "15s",
            "selected": true
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": false
          },
          {
            "text": "60s",
            "value": "60s",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors / min",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(gmod_lua_errors_total{job=\"$job\", instance=\"$instance\", realm=\"server\"}[$__rate_interval])) * 60) or vector(0)",
          "legendFormat": "server",
          "range": false,
          "instant": true,
          "refId": "A",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(gmod_lua_errors_total{job=\"$job\", instance=\"$instance\", realm=\"client\"}[$__rate_interval])) * 60) or vector(0)",
          "legendFormat": "client",
          "range": false,
          "instant": true,
          "refId": "B",
          "interval": "$export_interval"
        }
      ],
      "description": "Errors per minute, averaged over a minute: a single error shows as a short bump that goes back to zero a minute later. Lua errors on the server and errors that clients report to it. The text of each error is in the server console. Errors raised with Error or ErrorNoHalt are not counted, and GMod limits how many client errors reach the server.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Lua errors by addon",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 20,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (addon) (rate(gmod_lua_errors_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{addon}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "By addon: the addon title GMod reports, otherwise the addon folder from the error path (gamemode:<name> for gamemodes, base for GMod's own lua/includes), otherwise unknown, for example lua_run or files in garrysmod/lua. Errors per minute, averaged over a minute: a single error shows as a short bump that goes back to zero a minute later. Lua errors on the server and errors that clients report to it. The text of each error is in the server console. Errors raised with Error or ErrorNoHalt are not counted, and GMod limits how many client errors reach the server.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "errors per minute",
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1,
          "noValue": "No errors"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Addons with the most errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sort_desc(sum by (addon, realm) (increase(gmod_lua_errors_total{job=\"$job\", instance=\"$instance\"}[$__range])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "table",
          "interval": "$export_interval"
        }
      ],
      "description": "Errors over the selected time range by addon and realm, most first.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No errors"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "addon": 0,
              "realm": 1,
              "Value": 2
            },
            "renameByName": {
              "addon": "Addon",
              "realm": "Realm",
              "Value": "Errors"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Errors",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors per minute by realm",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (realm) (rate(gmod_lua_errors_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{realm}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "server: errors in the server Lua state. client: errors clients report to the server. A steady stream of client errors usually comes from one broken addon on everyone's machine.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "errors per minute",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1,
          "noValue": "No errors"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Lua memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(gmod_lua_memory_usage_bytes{job=\"$job\", instance=\"$instance\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "interval": "$export_interval"
        }
      ],
      "description": "Memory used by the server Lua state. A sawtooth is normal: memory grows until the garbage collector frees it. A rising lower edge over hours suggests an addon keeps references it doesn't need (a leak).",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Lua memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 18,
        "w": 20,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(gmod_lua_memory_usage_bytes{job=\"$job\", instance=\"$instance\"})",
          "legendFormat": "memory",
          "range": true,
          "instant": false,
          "refId": "A",
          "interval": "$export_interval"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min_over_time(max(gmod_lua_memory_usage_bytes{job=\"$job\", instance=\"$instance\"})[10m:15s])",
          "legendFormat": "10-minute minimum",
          "range": true,
          "instant": false,
          "refId": "B",
          "interval": "$export_interval"
        }
      ],
      "description": "Memory used by the server Lua state. A sawtooth is normal: memory grows until the garbage collector frees it. A rising lower edge over hours suggests an addon keeps references it doesn't need (a leak). The dashed line is the lowest value over the previous 10 minutes: it shows that lower edge.",
      "interval": "$export_interval",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "10-minute minimum"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
